---
import i18nConfig from '@i18n/config'
import Layout from '@layouts/Rebrand.astro'
import SiteNav from '@components/rebrand/SiteNav.vue'
import HeroScene from '@components/rebrand/HeroScene.vue'
import ContentBlock from '@components/rebrand/ContentBlock.vue'
import RichText from '@components/rebrand/RichText.vue'
import LinkList from '@components/rebrand/LinkList.vue'
import SloganBand from '@components/rebrand/SloganBand.vue'
import EventGroups from '@components/rebrand/EventGroups.vue'
import ItemList from '@components/rebrand/ItemList.vue'
import SiteFooter from '@components/rebrand/SiteFooter.vue'
import about from '@i18n/view/rebrand/about.js'
import shared from '@i18n/view/rebrand/shared.js'

export function getStaticPaths() {
  return i18nConfig.langs.map((lang) => ({
    params: { lang, about: lang === 'pt-br' ? 'sobre' : 'about' },
    props: { lang }
  }))
}

const { lang } = Astro.props
const page = about[lang]
const common = shared[lang]
const introLinks = page.intro.links.map((key) => common.social[key])
const talks = page.talks.items.map((talk) => ({ ...talk, cta: page.talks.cta }))
---

<Layout lang={lang} title={page.meta.title} description={page.meta.description} theme="blue">
  <SiteNav homeHref={`/${lang}/`} homeLabel={common.homeLabel} links={page.nav} />

  <HeroScene client:load variant="desk" {...page.hero} />

  <main>
    <ContentBlock id={page.intro.id} title={page.intro.title}>
      <RichText paragraphs={page.intro.paragraphs} />
      <div class="spaced"><LinkList links={introLinks} /></div>
    </ContentBlock>

    <ContentBlock id={page.bio.id} title={page.bio.title}>
      <RichText paragraphs={page.bio.paragraphs} size="md" />
    </ContentBlock>
  </main>

  <SloganBand client:visible label={page.slogan.label} lines={page.slogan.lines} />

  <main>
    <ContentBlock id={page.talks.id} title={page.talks.title}>
      <RichText paragraphs={page.talks.intro} size="md" />
      <EventGroups groups={page.talks.groups} />
      <ItemList items={talks} />
    </ContentBlock>
  </main>

  <SiteFooter sign={common.footer.sign} credits={common.footer.credits} />
</Layout>

<style>
  .spaced {
    margin-top: 28px;
  }
</style>
