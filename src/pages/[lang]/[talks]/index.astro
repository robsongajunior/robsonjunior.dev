---
import { getCollection } from 'astro:content';
import { getPageByLangCollection } from "@utils/pages.js";
import Layout from '@layouts/Base.astro';
import SiteNav from '@components/vue/SiteNav.vue';
import HeroScene from '@components/vue/HeroScene.vue';
import TalksBento from '@components/vue/TalksBento.vue';
import SiteFooter from '@components/vue/SiteFooter.vue';
import talksView from '@i18n/view/talks';
import about from '@i18n/view/about';
import shared from '@i18n/component/site';

export async function getStaticPaths() {
    const posts = await getCollection('talks') || [];

    return ['pt-br'].map((lang) => {
        const postsByLang = getPageByLangCollection(posts, lang) || [];

        postsByLang.map(post => {
            const slugParts = post.slug.split('/');
            const event = `${slugParts[1]}`;
            const postslug = lang === 'en' ? 'talks' : 'palestras';

            post.slug = `${lang}/${postslug}/${event}`;
        });

        return {
            params: {
                lang: lang,
                talks: lang === 'en' ? 'talks' : 'palestras'
            },
            props: {
                lang: lang,
                posts: postsByLang.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
            }
        };
    });
}
const { lang, posts } = Astro.props;

const page = talksView[lang]
const common = shared[lang]
const source = about[lang].talks
const ed = about[lang].editorial.talks
const talks = source.items.map((talk) => ({ ...talk, cta: source.cta }))

const talksProps = {
    id: source.id,
    intro: { index: ed.index, statement: ed.statement, summary: ed.summary },
    stats: {
        index: ed.statsIndex,
        items: [
            { value: ed.stats.events, label: ed.stats.eventsLabel, wide: true },
            { value: talks.length, label: ed.stats.decks },
            { value: new Date().getFullYear() - 2014, label: ed.stats.years }
        ]
    },
    events: { index: ed.eventsIndex, groups: source.groups },
    themes: ed.themes,
    list: { index: ed.listIndex, items: talks, external: ed.external }
}

const slides = talks.map((talk) => talk.title)
---

<Layout lang={lang} title={page.meta.title} description={page.meta.description} theme="lavender">
    <SiteNav homeHref={`/${lang}/`} homeLabel={common.homeLabel} links={common.nav} />
    <HeroScene client:load variant="stage" lines={slides} {...page.hero} />
    <main>
        <TalksBento {...talksProps} />
    </main>
    <SiteFooter sign={common.footer.sign} credits={common.footer.credits} />
</Layout>
