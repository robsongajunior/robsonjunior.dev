---
import { getCollection } from 'astro:content'
import Article from '@layouts/Article.astro'
import talksView from '@i18n/view/talks'

export async function getStaticPaths() {
  const collectionName = 'talks'
  const posts = (await getCollection(collectionName)) || []

  return posts.map((post) => {
    const slugParts = post.slug.split('/')
    const lang = slugParts[0]
    const talks = lang === 'en' ? 'talks' : 'palestras'
    const slug = post.slug.replace(`${lang}/`, '').replace(`${collectionName}/`, '').replace(`${talks}/`, '')

    return {
      params: { lang, slug, talks },
      props: post
    }
  })
}

const post = Astro.props
const { lang, talks } = Astro.params
const crumbs = [{ href: `/${lang}/${talks}/`, label: talksView[lang].hero.titleAccent }]
---

<Article lang={lang} entry={post} theme="lavender" crumbs={crumbs} />
