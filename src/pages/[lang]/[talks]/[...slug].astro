---
import { getCollection } from 'astro:content'
import Article from '@layouts/Article.astro'
import { entryAlternates, entryLang, entryPath, sectionOf } from '@utils/alternates.js'
import talksView from '@i18n/view/talks'

export async function getStaticPaths() {
  const collectionName = 'talks'
  const posts = (await getCollection(collectionName)) || []

  return posts.map((post) => {
    const lang = entryLang(post)
    const talks = sectionOf('talks', lang)
    const slug = entryPath(post)

    return {
      params: { lang, slug, talks },
      props: post
    }
  })
}

const post = Astro.props
const { lang, talks } = Astro.params
const crumbs = [{ href: `/${lang}/${talks}/`, label: talksView[lang].hero.titleAccent }]
const alternates = await entryAlternates('talks', post)
---

<Article lang={lang} entry={post} alternates={alternates} theme="lavender" crumbs={crumbs} />
