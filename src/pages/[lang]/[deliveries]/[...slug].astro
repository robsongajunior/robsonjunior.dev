---
import { getCollection } from 'astro:content'
import Article from '@layouts/Article.astro'
import { entryAlternates, entryLang, entryPath, sectionOf } from '@utils/alternates.js'
import deliveriesView from '@i18n/view/deliveries'

export async function getStaticPaths() {
  const collectionName = 'deliveries'
  const posts = (await getCollection(collectionName)) || []

  return posts.map((post) => {
    const lang = entryLang(post)
    const deliveries = sectionOf('deliveries', lang)
    const slug = entryPath(post)

    return {
      params: { lang, deliveries, slug },
      props: { lang, post }
    }
  })
}

const { lang, post } = Astro.props
const { deliveries } = Astro.params
const crumbs = [{ href: `/${lang}/${deliveries}/`, label: deliveriesView[lang].label }]
const alternates = await entryAlternates('deliveries', post)
---

<Article lang={lang} entry={post} alternates={alternates} theme="lime" crumbs={crumbs} />
