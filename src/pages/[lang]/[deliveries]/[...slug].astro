---
import { getCollection } from 'astro:content'
import Article from '@layouts/Article.astro'
import deliveriesView from '@i18n/view/deliveries'

export async function getStaticPaths() {
  const collectionName = 'deliveries'
  const posts = (await getCollection(collectionName)) || []

  return posts.map((post) => {
    const slugParts = post.slug.split('/')
    const lang = slugParts[0]
    const deliveries = lang === 'en' ? 'deliveries' : 'entregas'
    const slug = post.slug.replace(`${lang}/`, '').replace(`${collectionName}/`, '').replace(`${deliveries}/`, '')

    return {
      params: { lang, deliveries, slug },
      props: { lang, post }
    }
  })
}

const { lang, post } = Astro.props
const { deliveries } = Astro.params
const crumbs = [{ href: `/${lang}/${deliveries}/`, label: deliveriesView[lang].label }]
---

<Article lang={lang} entry={post} theme="lime" crumbs={crumbs} />
