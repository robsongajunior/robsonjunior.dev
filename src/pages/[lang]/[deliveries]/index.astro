---
import { getCollection } from 'astro:content'
import Layout from '@layouts/Base.astro'
import SiteNav from '@components/vue/SiteNav.vue'
import SiteFooter from '@components/vue/SiteFooter.vue'
import BlogCategory from '@components/vue/BlogCategory.vue'
import deliveriesView from '@i18n/view/deliveries'
import shared from '@i18n/component/site'
import { entryHref, entryLang, entryPath, pageAlternates, pageLangs, sectionOf } from '@utils/alternates.js'
import { byDateDesc, groupByYear, postCategories } from '@utils/blog.js'

export async function getStaticPaths() {
  const posts = await getCollection('deliveries')

  return pageLangs('deliveries').map((lang) => ({
    params: { lang, deliveries: sectionOf('deliveries', lang) },
    props: {
      lang,
      posts: posts
        .filter((post) => entryLang(post) === lang)
        .sort(byDateDesc)
    }
  }))
}

const { lang, posts } = Astro.props
const page = deliveriesView[lang]
const common = shared[lang]

const cards = posts.map((post) => ({
  href: entryHref('deliveries', post),
  title: post.data.title.split(' ').filter(Boolean).join(' '),
  tag: [entryPath(post).split('/')[0], ...postCategories(post).slice(0, 1)].join(' · ').toLowerCase(),
  date: post.data.date.toISOString().slice(0, 10),
  year: post.data.date.getUTCFullYear(),
  excerpt: post.data.meta_description
}))

const props = {
  crumbs: [{ label: page.label }],
  eyebrow: page.index,
  title: page.title,
  count: `${cards.length} ${cards.length === 1 ? page.item : page.items}`,
  years: groupByYear(cards),
  cta: page.cta
}
---

<Layout lang={lang} alternates={pageAlternates('deliveries')} title={page.meta.title} description={page.meta.description} theme="lime">
  <SiteNav homeHref={`/${lang}/`} homeLabel={common.homeLabel} links={common.nav} />
  <main>
    <BlogCategory {...props} />
  </main>
  <SiteFooter sign={common.footer.sign} credits={common.footer.credits} />
</Layout>
